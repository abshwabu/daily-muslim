<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/task_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/tv_task_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="DAILY ROUTINE"
            android:textColor="#546356"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tv_task_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="4 / 6 done"
            android:textColor="#546356"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Center Content (Next Task) -->
    <LinearLayout
        android:id="@+id/task_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/task_header"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_task_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPCOMING TASK"
            android:textColor="#5E6059"
            android:textSize="9sp"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Morning Quran recitation (1 Juz)"
            android:textColor="#31332E"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/tv_task_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Tap to manage daily tasks • Sakinah"
        android:textColor="#5E6059"
        android:textSize="10sp" />

</RelativeLayout>
