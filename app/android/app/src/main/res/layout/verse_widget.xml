<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verse_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/verse_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/tv_verse_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="DAILY REFLECTION"
            android:textColor="#546356"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tv_verse_ref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Surah Ash-Sharh 94:6"
            android:textColor="#5E6059"
            android:textSize="10sp" />
    </RelativeLayout>

    <!-- Center Content (Ayah Quote) -->
    <TextView
        android:id="@+id/tv_verse_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/verse_header"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="&quot;Verily, with every hardship comes ease.&quot;"
        android:textColor="#31332E"
        android:textSize="14sp"
        android:textStyle="italic" />

    <!-- Footer -->
    <TextView
        android:id="@+id/tv_verse_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Tap to read reflection • Sakinah"
        android:textColor="#5E6059"
        android:textSize="10sp" />

</RelativeLayout>
